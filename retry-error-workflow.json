{
  "name": "Error Triage - Retry Error API",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "retry-error",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "webhook-retry-error",
      "name": "Webhook - Retry Error",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300],
      "webhookId": "retry-error-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-execution-id",
              "leftValue": "={{$json.body.executionId}}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-execution-id",
      "name": "Has Execution ID?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.N8N_BASE_URL}}/api/v1/executions/{{$json.body.executionId}}/retry",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "n8nApi",
        "options": {}
      },
      "id": "http-retry-execution",
      "name": "Retry Execution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 220],
      "continueOnFail": true,
      "credentials": {
        "n8nApi": {
          "id": "REPLACE_WITH_YOUR_N8N_API_CREDENTIAL_ID",
          "name": "n8n account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "retry-had-error",
              "leftValue": "={{$json.error}}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-retry-failed",
      "name": "Did Retry Call Fail?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [940, 220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, executionId: $('Webhook - Retry Error').item.json.body.executionId, retriedAt: $now.toISO() } }}",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Access-Control-Allow-Origin", "value": "*" },
              { "name": "Content-Type", "value": "application/json" }
            ]
          }
        }
      },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1180, 140]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 502,
        "responseBody": "={{ { success: false, executionId: $('Webhook - Retry Error').item.json.body.executionId, error: 'The retry request to n8n failed. Check that the execution ID is still valid and the n8n API credential has not expired.' } }}",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Access-Control-Allow-Origin", "value": "*" },
              { "name": "Content-Type", "value": "application/json" }
            ]
          }
        }
      },
      "id": "respond-retry-error",
      "name": "Respond Retry Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1180, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 400,
        "responseBody": "={{ { success: false, error: 'Missing executionId in request body.' } }}",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Access-Control-Allow-Origin", "value": "*" },
              { "name": "Content-Type", "value": "application/json" }
            ]
          }
        }
      },
      "id": "respond-bad-request",
      "name": "Respond Bad Request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [700, 420]
    }
  ],
  "connections": {
    "Webhook - Retry Error": {
      "main": [[{ "node": "Has Execution ID?", "type": "main", "index": 0 }]]
    },
    "Has Execution ID?": {
      "main": [
        [{ "node": "Retry Execution", "type": "main", "index": 0 }],
        [{ "node": "Respond Bad Request", "type": "main", "index": 0 }]
      ]
    },
    "Retry Execution": {
      "main": [[{ "node": "Did Retry Call Fail?", "type": "main", "index": 0 }]]
    },
    "Did Retry Call Fail?": {
      "main": [
        [{ "node": "Respond Retry Error", "type": "main", "index": 0 }],
        [{ "node": "Respond Success", "type": "main", "index": 0 }]
      ]
    }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "meta": { "instanceId": "replace-with-your-n8n-instance-id" },
  "id": "error-triage-retry-error",
  "tags": []
}
